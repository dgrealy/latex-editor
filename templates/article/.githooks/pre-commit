#!/usr/bin/env bash
# Fast checks only -- the full compile runs in CI, so committing stays quick.
# Install with:  git config core.hooksPath .githooks
#
# These checks run only inside the dev container, which is the one place the
# toolchain is guaranteed to exist. A git hook runs wherever you type `git
# commit`, and on a bare host the Python dependencies are absent -- so rather
# than half-running and reporting confusing failures, it stands aside.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 0

# The container image sets DEVCONTAINER=true, which every process inside it
# inherits. Delete these three lines to run the checks on the host as well.
if [ "${DEVCONTAINER:-}" != "true" ]; then
  echo "pre-commit: skipped (outside the dev container)" >&2
  exit 0
fi

# Find the plugin's scripts. Search rather than trust a recorded path: the same
# repository gets committed from the container and from the host, and a path
# written at scaffold time is right in at most one of them.
find_scripts() {
  local candidate
  for candidate in \
      "${CLAUDE_PLUGIN_ROOT:-}/scripts" \
      "${LATEX_EDITOR_SCRIPTS:-}" \
      "$([ -f .latex-editor/scripts-path ] && cat .latex-editor/scripts-path)" \
      "${HOME:-}"/.claude/plugins/*/latex-editor/scripts \
      "${HOME:-}"/.claude/latex-editor/scripts; do
    if [ -n "$candidate" ] && [ -d "$candidate" ]; then
      printf '%s' "$candidate"
      return 0
    fi
  done
  return 1
}

scripts="$(find_scripts)" || {
  echo "pre-commit: latex-editor scripts not found; skipping checks." >&2
  echo "            Set LATEX_EDITOR_SCRIPTS to the plugin's scripts directory." >&2
  exit 0
}

status=0
bib="$(ls bib/*.bib 2>/dev/null | head -1)"

echo "pre-commit: cross-references"
python3 "$scripts/ref_check.py" --root . ${bib:+--bib "$bib"} || status=1

if [ -n "$bib" ]; then
  echo "pre-commit: bibliography"
  python3 "$scripts/bib_lint.py" "$bib" --provenance .latex-editor/bib-provenance.json || status=1
fi

changed="$(git diff --cached --name-only --diff-filter=ACM -- '*.tex')"
if [ -n "$changed" ]; then
  # reflow.py parses LaTeX, so it needs pylatexenc. Check before calling it:
  # a missing dependency should be a sentence, not a stack trace.
  if python3 -c "import pylatexenc" >/dev/null 2>&1; then
    echo "pre-commit: sentence-per-line"
    # Advisory: report, never block, since reflowing is the author's call.
    python3 "$scripts/reflow.py" --check $changed || true
  else
    echo "pre-commit: sentence-per-line skipped (no pylatexenc; pip install pylatexenc)" >&2
  fi
fi

if [ "$status" -ne 0 ]; then
  echo
  echo "pre-commit: problems above. Commit anyway with --no-verify if you meant to."
fi
exit "$status"
